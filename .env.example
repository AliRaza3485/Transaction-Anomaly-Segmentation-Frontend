# Server-only base URL of the FastAPI anomaly detection backend.
# The Next.js proxy routes (app/api/predict, app/api/predict/batch,
# app/api/health) read this via process.env.API_URL and forward requests to it.
# Keep it SERVER-ONLY — do NOT prefix with NEXT_PUBLIC_ so it never ships to
# the browser (this is what avoids HTTPS-site -> HTTP-backend mixed-content
# blocking). No trailing slash. Use your EC2 public IP and the API port (8000).
API_URL=http://REPLACE_WITH_EC2_PUBLIC_IP:8000
